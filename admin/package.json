{
  "name": "photocopie-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute photocopie-admin-db --local --file=./migrations/0001_init.sql",
